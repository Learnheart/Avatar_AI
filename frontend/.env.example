# Frontend (Vite) — copy to frontend/.env to override. All keys are optional.

# Backend WebSocket endpoint. Default: ws://<page hostname>:8000/ws
VITE_WS_URL=

# URL of the VRM avatar model, served from frontend/public. Default: /models/avatar.vrm
VITE_VRM_PATH=

# Backend HTTP API, used by the knowledge panel. Default: http://<page hostname>:8000
VITE_API_URL=
