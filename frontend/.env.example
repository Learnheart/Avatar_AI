# Frontend (Vite) — copy to frontend/.env to override. All keys are optional.

# Backend WebSocket endpoint. Default: ws://<page hostname>:8000/ws
VITE_WS_URL=

# URL of the VRM avatar model, served from frontend/public. Default: /models/avatar.vrm
VITE_VRM_PATH=

# Backend HTTP API, used by the knowledge panel and the profile page. Default: http://<page hostname>:8000
VITE_API_URL=

# Milliseconds before the page presents its session token again, after the backend
# could not tell whose it is (its database failed). Default: 5000
VITE_AUTH_RETRY_MS=
