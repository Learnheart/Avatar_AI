# Only `groq_api_key` is required. Every other entry is an optional override and is
# commented out: its default lives in the code, so tune it there —
#   backend/prompts.py   texts (system prompt, fallback sentence)
#   backend/tuning.py    behaviour (VAD, timeouts, head clamps, voice)
#   backend/config.py    per-machine and provider values (server, camera, models)
# Uncomment an entry only to override the default on this machine.

# ── Server ────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# ── Groq — STT + LLM (REQUIRED) ───────────────────────────────────────
# The key name is lowercase on purpose.
groq_api_key=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# SDK retries per Groq request; 0 = fail fast, the engine has its own fallback
# GROQ_MAX_RETRIES=0

# ── Device Capability Router ──────────────────────────────────────────
# auto | metal | cuda | cpu
# DEVICE=auto

# ── Camera + head tracking ────────────────────────────────────────────
# CAMERA_INDEX=0
# CAMERA_URL=
# CAMERA_ROTATE=0
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
# Seconds between attempts to (re)open the camera
# CAMERA_RETRY_SEC=2.0
# TRACKING_FPS=30
# Faces detected per frame; the largest one is tracked
# TRACKING_MAX_FACES=3
# TRACKING_MIN_CONFIDENCE=0.5

# ── VAD ───────────────────────────────────────────────────────────────
# VAD_THRESHOLD=0.5
# End-of-speech confirmation window
# VAD_MIN_SILENCE_MS=500
# VAD_SPEECH_PAD_MS=100
# Audio kept before speech_start
# VAD_PREROLL_MS=300

# ── STT ───────────────────────────────────────────────────────────────
# auto (picked by the router) | groq_whisper
# STT_BACKEND=auto
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=vi
# STT_TIMEOUT_SEC=8
# STT_MAX_UTTERANCE_SEC=30

# ── LLM ───────────────────────────────────────────────────────────────
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=512
# Max wait for each streamed delta (first token included)
# LLM_TIMEOUT_SEC=8
# Spoken when the LLM fails
# LLM_FALLBACK_TEXT=Xin lỗi, tôi chưa thể trả lời ngay lúc này. Quý khách vui lòng thử lại sau.

# ── TTS ───────────────────────────────────────────────────────────────
# TTS_BACKEND=zerotts
# A Hugging Face repo id, or a local directory of real files. onnxruntime >= 1.30 rejects
# the HF symlink/blob cache for this model's external-data (.data) file ("path escapes
# model directory"), so point this at a materialized directory to avoid that:
#   python -c "from huggingface_hub import snapshot_download as d; d('zeroweight-ai/ZeroTTS', local_dir='backend/assets/zerotts')"
#   ZEROTTS_REPO=backend/assets/zerotts
# ZEROTTS_REPO=zeroweight-ai/ZeroTTS
# ZEROTTS_VOICE=maichi
# Size of each audio message
# TTS_CHUNK_MS=240
# Per sentence
# TTS_TIMEOUT_SEC=10

# ── Head rotation clamps (radians) ────────────────────────────────────
# HEAD_PITCH_MAX=0.52
# HEAD_YAW_MAX=0.78
# HEAD_ROLL_MAX=0.35

# ── Timeouts ──────────────────────────────────────────────────────────
# No face for this long → head returns to neutral
# NO_FACE_TIMEOUT_SEC=3.0
# TURN_TIMEOUT_SEC=30
# Grace after the estimated end of playback
# PLAYBACK_END_TIMEOUT_SEC=2

# ── Errors ────────────────────────────────────────────────────────────
# Characters of a provider error's text kept in error messages and logs
# ERROR_SUMMARY_MAX_CHARS=200

# ── System prompt ─────────────────────────────────────────────────────
# SYSTEM_PROMPT=Bạn là Chuyên viên tài chính VIP tại ngân hàng. Hãy trả lời bằng tiếng Việt, phong cách chuyên nghiệp, trang trọng và thân thiện. Câu trả lời ngắn gọn, rõ ràng, tối đa 2-3 câu mỗi lượt.

# ── Frontend (Vite) ───────────────────────────────────────────────────
VITE_WS_URL=ws://localhost:8000/ws
VITE_VRM_PATH=/models/avatar.vrm

# ── Legacy (unused) ───────────────────────────────────────────────────
# Kept from the Gemini Live POC; nothing reads these any more.
# groq=
# SNAPSHOT_INTERVAL_SEC=2.5
# SNAPSHOT_QUALITY=70
# SNAPSHOT_MAX_WIDTH=640
# VAD_SILENCE_TIMEOUT_SEC=30.0
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_RESPONSE_TIMEOUT_SEC=15.0
# GEMINI_VOICE=Kore
# GEMINI_IDLE_TIMEOUT_SEC=30.0
# TTS mode: gemini | azure | viettel
# TTS_MODE=gemini
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=eastasia
# AZURE_TTS_VOICE=vi-VN-HoaiMyNeural
# VIETTEL_TTS_KEY=
# VIETTEL_TTS_URL=
