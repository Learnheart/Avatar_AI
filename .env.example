# Only `groq_api_key` is required. Every other entry is an optional override and is
# commented out: its default lives in the code, so tune it there —
#   backend/tuning.py    behaviour (VAD, timeouts, head clamps, voice)
#   backend/config.py    per-machine and provider values (server, camera, models)
# Uncomment an entry only to override the default on this machine.
# Prompts are not configurable here: they live in backend/prompts.py only.

# ── Server ────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# ── Observability ─────────────────────────────────────────────────────
# Every step of a turn is a span, logged as a `Span` line and, when this is set, sent
# with the metrics to an OTLP/HTTP backend (its /v1/traces and /v1/metrics).
# OTLP_ENDPOINT=http://localhost:4318
# Headers of the OTLP requests, key=value,key=value (the backend's API key)
# OTLP_HEADERS=
# SERVICE_NAME=avatar-ai
# Characters of a text value (transcript, prompt, answer) shown in a `Span` log line
# TRACE_LOG_VALUE_MAX_CHARS=200
# Seconds between two pushes of the metrics
# METRIC_EXPORT_INTERVAL_SEC=15
# Full capture on local disk: every tracked camera frame, the audio of each utterance and
# answer, the spans of each turn. It stores FACES AND VOICES: off unless set to 1.
# CAPTURE_ENABLED=0
# CAPTURE_DIR=backend/data/capture
# Camera images kept per second (0 = every tracked frame, about 8 GB per hour at 30 fps)
# CAPTURE_FRAME_FPS=0
# CAPTURE_JPEG_QUALITY=80
# The oldest hours are deleted when the directory grows past this
# CAPTURE_MAX_GB=20
# Items that may wait for the writer before new ones are dropped
# CAPTURE_QUEUE_SIZE=64

# ── Groq — STT + LLM (REQUIRED) ───────────────────────────────────────
# The key name is lowercase on purpose.
groq_api_key=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# SDK retries per Groq request; 0 = fail fast, the engine has its own fallback
# GROQ_MAX_RETRIES=0

# ── Device Capability Router ──────────────────────────────────────────
# auto | metal | cuda | cpu
# DEVICE=auto

# ── Camera + head tracking ────────────────────────────────────────────
# CAMERA_INDEX=0
# CAMERA_URL=
# CAMERA_ROTATE=0
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
# Seconds between attempts to (re)open the camera
# CAMERA_RETRY_SEC=2.0
# TRACKING_FPS=30
# Faces detected per frame; the largest one is tracked
# TRACKING_MAX_FACES=3
# TRACKING_MIN_CONFIDENCE=0.5

# ── VAD ───────────────────────────────────────────────────────────────
# VAD_THRESHOLD=0.5
# End-of-speech confirmation window
# VAD_MIN_SILENCE_MS=500
# VAD_SPEECH_PAD_MS=100
# Audio kept before speech_start
# VAD_PREROLL_MS=300

# ── STT ───────────────────────────────────────────────────────────────
# auto (picked by the router) | groq_whisper | openai_compatible
#   | databricks (a chat model of the Databricks AI Gateway is sent the audio)
# Used when STT_BACKEND=openai_compatible
# STT_BASE_URL=
# STT_API_KEY=
# STT_BACKEND=auto
# Takes over when STT_BACKEND fails (same names, empty = no backup)
# STT_BACKEND_BACKUP=databricks
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=vi
# STT_TIMEOUT_SEC=8
# STT_MAX_UTTERANCE_SEC=30
# Only when a chat model does the STT (STT_BACKEND=databricks)
# STT_REASONING_EFFORT=minimal
# STT_MAX_TOKENS=512
# An utterance whose every segment has a no-speech probability above this is dropped as
# noise (Whisper backends only); 1.0 = nothing is refused
# STT_NO_SPEECH_MAX_PROB=1.0

# ── LLM ───────────────────────────────────────────────────────────────
# groq | openai_compatible (another API such as OpenRouter, or a self-hosted server)
#   | databricks (Databricks AI Gateway, OpenAI Responses API)
# LLM_BACKEND=groq
# Takes over when LLM_BACKEND fails (same names, empty = no backup)
# LLM_BACKEND_BACKUP=databricks
# Used when LLM_BACKEND=openai_compatible; the key may stay empty for a keyless server
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=512
# Max wait for each streamed delta (first token included)
# LLM_TIMEOUT_SEC=8
# A whole answer asked outside a turn (reading an import or a closed conversation): its
# max wait and length
# LLM_COMPLETE_TIMEOUT_SEC=30
# LLM_COMPLETE_MAX_TOKENS=2048

# ── Conversation (short-term memory) ──────────────────────────────────
# The avatar remembers the turns of the running conversation. It closes after this long
# without a face (while the camera is connected) ...
# CONVERSATION_ABSENCE_SEC=30
# ... or this long after its last turn ended
# CONVERSATION_IDLE_SEC=120
# The earlier turns of the conversation given to the LLM cost at most this many
# tokens; past it the oldest turns are dropped, whole
# MEMORY_HISTORY_MAX_TOKENS=2000
# Tokens are estimated from the text: this many characters make one token (measured
# with spoken Vietnamese: 3.3; lower = less history kept)
# MEMORY_HISTORY_CHARS_PER_TOKEN=3.0

# ── Databricks AI Gateway ─────────────────────────────────────────────
# Used when LLM_BACKEND=databricks and/or STT_BACKEND=databricks. The URL is required,
# and one credential: a static token, or a Databricks CLI profile whose token is fetched
# and renewed for you (`databricks auth login --profile <name>` once).
# DATABRICKS_BASE_URL=https://<workspace>.cloud.databricks.com/ai-gateway/mlflow/v1
# DATABRICKS_TOKEN=
# DATABRICKS_PROFILE=
# Gateway model names, <catalog>.<schema>.<endpoint>
# DATABRICKS_LLM_MODEL=nonprod_ai.tsfai.glm-5-3-flash-dev-tai
# DATABRICKS_STT_MODEL=nonprod_ai.tsfai.gemini-3-6-flash-dev-tai
# Seconds before its expiry at which a profile token is renewed
# DATABRICKS_TOKEN_REFRESH_MARGIN_SEC=120
# Behind a proxy that re-signs TLS, point Python at a CA bundle that holds the proxy's
# certificate (the OpenAI client reads this variable):
# SSL_CERT_FILE=/path/to/ca-bundle.pem

# ── Application database + memory (what is kept about a known person) ─
# The database of the users and the memory: a SQLAlchemy URL. A SQLite file locally;
# PostgreSQL at deployment (postgresql+psycopg://user:password@host/dbname, with its
# driver installed). The missing tables are created at startup.
# DATABASE_URL=sqlite:///backend/data/app.db
# Development and tests: the id of the user every connection and request belongs to,
# without sign-in. Empty = the session token decides (no token = a guest, who has no
# memory and gets 401 on the /memory and /persona routes).
# AUTH_DEV_USER_ID=

# ── Sign-in (guest or signed-in user) ─────────────────────────────────
# 0: accounts cannot be created at the kiosk
# AUTH_ALLOW_REGISTRATION=1
# An account is an email address, created once the code sent to it is given back:
# within this long, in at most this many tries; another code can be asked for after
# this many seconds
# AUTH_OTP_TTL_MINUTES=10
# AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_OTP_RESEND_SEC=60
# How that code is sent. `log` (the default) writes the mail to the backend log and
# sends nothing: for a machine without a mail server, it proves nothing about who owns
# the address. `smtp` sends it: set this in any deployment.
# MAIL_BACKEND=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# The address the mails come from
# SMTP_FROM=Magic Mirror <no-reply@example.com>
# starttls (port 587), ssl (port 465) or none
# SMTP_SECURITY=starttls
# Max wait for the SMTP server
# SMTP_TIMEOUT_SEC=10
# Shortest password a local account accepts
# AUTH_PASSWORD_MIN_CHARS=8
# A session is kept until it was not used for this long (every use pushes the end
# back), or is this old whatever happened. On a shared kiosk these bound how long the
# next person is taken for the one who signed in: minutes there, days on a device of
# one person (AUTH_SESSION_IDLE_MINUTES=43200, AUTH_SESSION_MAX_HOURS=720).
# AUTH_SESSION_IDLE_MINUTES=30
# AUTH_SESSION_MAX_HOURS=12
# 1: the session also ends when the person leaves the kiosk or goes silent
# AUTH_LOGOUT_ON_LEAVE=0
# How often the session of the connected page is looked at
# AUTH_SESSION_CHECK_SEC=30
# Failed sign-ins on one email before it is held, and the window they are counted in
# (also how long it is held)
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_WINDOW_MINUTES=10
# Sign-in with Google / Facebook. A provider whose client id is empty is not offered.
# Register an application at the provider with the redirect URI
# <AUTH_PUBLIC_URL>/auth/google/callback (or .../facebook/callback).
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_FACEBOOK_CLIENT_ID=
# AUTH_FACEBOOK_CLIENT_SECRET=
# The address of this backend as the browser reaches it, and the address of the page
# the person returns to (both required by the providers, no trailing slash)
# AUTH_PUBLIC_URL=http://localhost:8000
# AUTH_PAGE_URL=http://localhost:3000
# Max wait for a provider during a sign-in
# AUTH_PROVIDER_TIMEOUT_SEC=10
# Where each provider is asked (the defaults are the public endpoints)
# AUTH_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# AUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# AUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# AUTH_GOOGLE_SCOPE=openid email profile
# AUTH_FACEBOOK_AUTHORIZE_URL=https://www.facebook.com/v19.0/dialog/oauth
# AUTH_FACEBOOK_TOKEN_URL=https://graph.facebook.com/v19.0/oauth/access_token
# AUTH_FACEBOOK_USERINFO_URL=https://graph.facebook.com/v19.0/me?fields=id,name,email
# AUTH_FACEBOOK_SCOPE=public_profile email
# Memory items given to the LLM as the profile of the person
# MEMORY_PROMPT_MAX_ITEMS=20
# Max wait for the memory: for the profile in a turn (past it the question is answered
# without it), and at shutdown for the turns still being written
# MEMORY_TIMEOUT_SEC=1.0
# Characters of one memory item (a short sentence); a longer text is refused
# MEMORY_ITEM_MAX_CHARS=200
# The directory holding the original of what users import (one store for all users;
# who owns a file is recorded in the database)
# OBJECT_STORE_DIR=backend/data/objects
# An import (a file or a pasted text a person describes themselves with): the largest
# file, and the most characters of text read by the LLM; past either it is refused
# MEMORY_IMPORT_MAX_FILE_MB=5
# MEMORY_IMPORT_MAX_CHARS=20000
# Gathering from conversations: a closed conversation of a known person is read once by
# the LLM into proposed items, approved or rejected on the profile page.
# A proposed preference or personality trait becomes active by itself once this many
# conversations stated it (a name or a way of addressing never does)
# MEMORY_PROMOTE_SEEN_COUNT=2
# An utterance the STT was less sure of than this (0-1) is not read (0 = all are read)
# MEMORY_MIN_STT_CONFIDENCE=0.6
# The stored turns are deleted once their conversation was read, and after this many
# days whatever happened
# MEMORY_TRANSCRIPT_TTL_DAYS=7
# Characters of a conversation read in one request; a longer one keeps its latest turns
# MEMORY_CONSOLIDATE_MAX_CHARS=20000
# Rejected items shown to the LLM that reads a conversation, the most recently rejected
# first (0 = none); one that is not shown is still never proposed again
# MEMORY_EXTRACT_MAX_REJECTED=50

# ── Persona (the personality a known person gives the avatar) ─────────
# Characters of one field of the persona (name, role, addressing, ...); a longer text
# is refused
# PERSONA_FIELD_MAX_CHARS=300
# Characters of a pasted description of the avatar read by the LLM into the fields; a
# longer one is refused
# PERSONA_IMPORT_MAX_CHARS=8000
# Max wait for the persona in a turn; past it the question is answered with the
# default character
# PERSONA_TIMEOUT_SEC=1.0

# ── Knowledge base (uploaded documents) ───────────────────────────────
# The SQLite (sqlite-vec) file holding the documents, their chunks and the vectors
# KNOWLEDGE_DB_PATH=backend/data/knowledge.db
# local_hash (no model, no network; matches words, not meaning)
#   | openai_compatible (any /embeddings API) | databricks (a workspace embedding endpoint)
#   | ollama (a local Ollama server)
# Changing the embedding re-indexes the stored documents at the next start.
# EMBEDDING_BACKEND=local_hash
# Takes over when EMBEDDING_BACKEND fails (same names, empty = no backup). It must serve
# the SAME model as the primary: its vectors are searched in the primary's index.
# EMBEDDING_BACKEND_BACKUP=ollama
# Used when an embedding backend is ollama (`ollama pull qwen3-embedding:0.6b` once)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Used when EMBEDDING_BACKEND=openai_compatible; the key may stay empty for a keyless server
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# Used when EMBEDDING_BACKEND=databricks, with DATABRICKS_TOKEN or DATABRICKS_PROFILE.
# The serving endpoints root of the workspace, not the AI Gateway URL.
# DATABRICKS_SERVING_BASE_URL=https://<workspace>.cloud.databricks.com/serving-endpoints
# DATABRICKS_EMBEDDING_MODEL=databricks-qwen3-embedding-0-6b
# Texts per embedding request, and the timeout of one request
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_TIMEOUT_SEC=20
# Vector size of the local_hash embedding
# EMBEDDING_HASH_DIM=1024
# Passages given to the LLM with the question
# KNOWLEDGE_TOP_K=4
# Cosine similarity below which a passage is not used (0 = keep the top K)
# KNOWLEDGE_MIN_SCORE=0.0
# Max wait for the lookup in a turn; past it the question is answered without it
# KNOWLEDGE_TIMEOUT_SEC=2.0
# Previous utterances of the person searched together with the current one, so a
# follow-up finds the passages of its subject (0 = the current utterance alone)
# KNOWLEDGE_QUERY_HISTORY_TURNS=1
# Size of a chunk of a document, and how much of it is repeated in the next one
# KNOWLEDGE_CHUNK_CHARS=800
# KNOWLEDGE_CHUNK_OVERLAP_CHARS=120
# KNOWLEDGE_MAX_FILE_MB=10
# Origins allowed to call the HTTP API from a browser, comma-separated; * = any
# CORS_ALLOW_ORIGINS=*

# ── TTS ───────────────────────────────────────────────────────────────
# TTS_BACKEND=zerotts
# A Hugging Face repo id, or a local directory of real files. onnxruntime >= 1.30 rejects
# the HF symlink/blob cache for this model's external-data (.data) file ("path escapes
# model directory"), so point this at a materialized directory to avoid that:
#   python -c "from huggingface_hub import snapshot_download as d; d('zeroweight-ai/ZeroTTS', local_dir='backend/assets/zerotts')"
#   ZEROTTS_REPO=backend/assets/zerotts
# ZEROTTS_REPO=zeroweight-ai/ZeroTTS
# ZEROTTS_VOICE=maichi
# Size of each audio message
# TTS_CHUNK_MS=240
# Per sentence
# TTS_TIMEOUT_SEC=10

# ── Head rotation clamps (radians) ────────────────────────────────────
# HEAD_PITCH_MAX=0.52
# HEAD_YAW_MAX=0.78
# HEAD_ROLL_MAX=0.35

# ── Timeouts ──────────────────────────────────────────────────────────
# No face for this long → head returns to neutral
# NO_FACE_TIMEOUT_SEC=3.0
# TURN_TIMEOUT_SEC=30
# Grace after the estimated end of playback
# PLAYBACK_END_TIMEOUT_SEC=2

# ── Backup backends ───────────────────────────────────────────────────
# How long the primary may take (STT answer / LLM first delta) before the backup is used
# FALLBACK_PRIMARY_TIMEOUT_SEC=3.0
# After a failure the primary is skipped for this long, then tried again
# FALLBACK_COOLDOWN_SEC=300

# ── Errors ────────────────────────────────────────────────────────────
# Characters of a provider error's text kept in error messages and logs
# ERROR_SUMMARY_MAX_CHARS=200

# ── Frontend (Vite) ───────────────────────────────────────────────────
VITE_WS_URL=ws://localhost:8000/ws
VITE_API_URL=http://localhost:8000
VITE_VRM_PATH=/models/avatar.vrm

# ── Legacy (unused) ───────────────────────────────────────────────────
# Kept from the Gemini Live POC; nothing reads these any more.
# groq=
# SNAPSHOT_INTERVAL_SEC=2.5
# SNAPSHOT_QUALITY=70
# SNAPSHOT_MAX_WIDTH=640
# VAD_SILENCE_TIMEOUT_SEC=30.0
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_RESPONSE_TIMEOUT_SEC=15.0
# GEMINI_VOICE=Kore
# GEMINI_IDLE_TIMEOUT_SEC=30.0
# TTS mode: gemini | azure | viettel
# TTS_MODE=gemini
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=eastasia
# AZURE_TTS_VOICE=vi-VN-HoaiMyNeural
# VIETTEL_TTS_KEY=
# VIETTEL_TTS_URL=
